# 管理后台登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me
# 会话签名密钥，生产环境请换成随机长字符串
ADMIN_SECRET=please-change-this-secret

# 与 taro-api 共用的 MySQL（腾讯云 CynosDB）
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=taro

# 商品图上传。未填写时会读取同级 taro-api/.env
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
